<!-- ===================== HERO ===================== -->
<section class="hero">
  <div class="wrap hero-inner">
    <p class="eyebrow boot" style="--d:0">// Claude Code control plane · status: <span class="ok">OPERATIONAL</span></p>
    <h1 class="boot" style="--d:1">Ship software with<br><span class="glow">a disciplined autopilot.</span></h1>
    <p class="lede boot" style="--d:2">
      <strong>claude-flightdeck</strong> installs a layered system of <code>CLAUDE.md</code> files,
      specialized subagents, slash-command skills, mechanical rule maps, and a
      6-gate review loop into any project — so Claude Code runs your whole SDLC
      <em>design-first, test-first, and review-gated</em>, not vibes-first.
    </p>
    <div class="cta boot" style="--d:3">
      <a class="btn primary" href="#install">Install</a>
      <a class="btn" href="workflow.html">See the workflow →</a>
      <a class="btn ghost" href="__GH__" target="_blank" rel="noopener">GitHub ↗</a>
    </div>
    <p class="telemetry mono boot" style="--d:4" data-type="$ ./install.sh ~/code/my-project  →  control plane online"></p>
  </div>
</section>

<!-- ===================== STAT GAUGES ===================== -->
<section class="gauges">
  <div class="wrap gauge-row">
    <div class="gauge reveal"><span class="num" data-count="__N_AGENTS__">0</span><span class="lbl">specialized agents</span></div>
